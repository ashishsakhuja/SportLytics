"use client";

import { useEffect, useState } from "react";

type Props = {
  chartId: string;
  sport: string;
  season: number;
  seasonType: string;
  team: string;
  summary: any;
};

export default function ChartCaption({
  chartId,
  sport,
  season,
  seasonType,
  team,
  summary,
}: Props) {
  const [caption, setCaption] = useState("Generating insight...");
  const [loading, setLoading] = useState(true);

  useEffect(() => {
    async function fetchCaption() {
      setLoading(true);

      const res = await fetch(
        `${process.env.NEXT_PUBLIC_API_BASE}/ai/chart-caption`,
        {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            chart_id: chartId,
            sport,
            season,
            season_type: seasonType,
            team,
            summary,
          }),
        }
      );

      const data = await res.json();
      setCaption(data.caption);
      setLoading(false);
    }

    fetchCaption();
  }, [chartId, sport, season, seasonType, team, summary]);

  return (
    <div
      style={{
        marginTop: "8px",
        fontSize: "14px",
        color: "#aaa",
        fontStyle: "italic",
      }}
    >
      {loading ? "Generating insight..." : caption}
    </div>
  );
}